---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";
import { site } from "../../lib/site";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Base
  title="Writing"
  description="Notes on backend systems, event sourcing, and agent infrastructure."
  noindex={posts.length === 0}
>
  <section class="mx-auto max-w-5xl px-5 pb-8 pt-16 sm:px-8 sm:pt-20">
    <h1
      class="font-display text-[2rem] font-semibold leading-tight tracking-[-0.03em] text-ink sm:text-[2.75rem]"
    >
      Writing
    </h1>
    <p class="mt-4 max-w-[58ch] text-[18px] leading-relaxed text-ink-secondary">
      Notes on backend systems, event sourcing, and agent infrastructure.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-5 sm:px-8">
    {
      posts.length === 0 ? (
        <div class="rounded-[4px] border border-dashed border-rule-strong px-6 py-14 text-center">
          <p class="text-[16.5px] text-ink-secondary">
            Nothing published yet.
          </p>
          <p class="mx-auto mt-2 max-w-[44ch] text-[15px] leading-relaxed text-ink-muted">
            The first posts will cover what came out of building Reckon and
            Amortize. Until then, the case studies carry the detail.
          </p>
          <a
            href="/#projects"
            class="mt-6 inline-flex items-center gap-1.5 rounded-[4px] text-sm font-medium text-accent transition-colors hover:text-accent-hover"
          >
            Read the case studies
            <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
          </a>
        </div>
      ) : (
        <ul>
          {posts.map((post) => (
            <li class="border-t border-rule" data-reveal>
              <a
                href={`/writing/${post.id}/`}
                class="group grid gap-2 py-7 sm:grid-cols-[9rem_1fr] sm:gap-10"
              >
                <time
                  datetime={post.data.date.toISOString()}
                  class="font-mono text-[14px] text-ink-muted tnum"
                >
                  {fmt.format(post.data.date)}
                </time>
                <div>
                  <h2 class="text-lg font-semibold tracking-tight text-ink transition-colors group-hover:text-accent">
                    {post.data.title}
                  </h2>
                  <p class="mt-1.5 max-w-[62ch] text-[16.5px] leading-relaxed text-ink-secondary">
                    {post.data.description}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    posts.length > 0 && (
      <p class="mx-auto mt-12 max-w-5xl px-5 text-[14px] text-ink-muted sm:px-8">
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-1.5 rounded-[4px] transition-colors hover:text-accent"
        >
          <Icon name="ph:rss-simple" class="size-4" aria-hidden="true" />
          Subscribe by RSS
        </a>
      </p>
    )
  }
</Base>
