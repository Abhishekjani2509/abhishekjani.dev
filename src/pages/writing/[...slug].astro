---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Base title={entry.data.title} description={entry.data.description} article>
  <article class="mx-auto max-w-5xl px-5 pb-8 pt-12 sm:px-8 sm:pt-16">
    <a
      href="/writing"
      class="inline-flex items-center gap-1.5 rounded-[4px] text-sm text-ink-secondary transition-colors hover:text-accent"
    >
      <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
      All writing
    </a>

    <header class="mt-8 border-b border-rule pb-8">
      <time
        datetime={entry.data.date.toISOString()}
        class="font-mono text-[14px] text-ink-muted tnum"
      >
        {fmt.format(entry.data.date)}
      </time>

      <h1
        class="mt-3 max-w-[24ch] text-[2rem] font-semibold leading-tight tracking-[-0.03em] text-ink sm:text-[2.5rem]"
      >
        {entry.data.title}
      </h1>

      <p class="mt-4 max-w-[58ch] text-[18px] leading-relaxed text-ink-secondary">
        {entry.data.description}
      </p>
    </header>

    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</Base>
