---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);

const trackLabel =
  p.track === "backend" ? "Backend systems" : "Agent infrastructure";

---

<Base title={p.title} description={p.tagline} article noindex>
  <article class="mx-auto max-w-5xl px-5 pb-8 pt-12 sm:px-8 sm:pt-16">
    <a
      href="/#projects"
      class="inline-flex items-center gap-1.5 rounded-[4px] text-sm text-ink-secondary transition-colors hover:text-accent"
    >
      <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
      All projects
    </a>

    <header class="mt-8 border-b border-rule pb-10">
      <p class="text-[14px] text-accent">{trackLabel}</p>

      <h1
        class="mt-3 font-display text-[2rem] font-semibold leading-tight tracking-[-0.03em] text-ink sm:text-[2.75rem]"
      >
        {p.title}
      </h1>

      <p
        class="mt-4 max-w-[58ch] text-[18px] leading-relaxed text-ink-secondary sm:text-lg"
      >
        {p.tagline}
      </p>

      <dl class="mt-8 grid gap-x-10 gap-y-5 sm:grid-cols-2">
        <div>
          <dt class="text-[14px] text-ink-muted">Year</dt>
          <dd class="mt-1 font-mono text-[16px] text-ink tnum">{p.year}</dd>
        </div>
        <div>
          <dt class="text-[14px] text-ink-muted">Stack</dt>
          <dd class="mt-1 font-mono text-[13.5px] leading-relaxed text-ink">
            {p.stack.join(" / ")}
          </dd>
        </div>
      </dl>

      {
        p.kind === "team" && p.role && (
          <p class="mt-6 max-w-[58ch] border-l-2 border-accent pl-4 text-[16px] leading-relaxed text-ink-secondary">
            My part: {p.role.charAt(0).toLowerCase() + p.role.slice(1)}.
          </p>
        )
      }

      <div class="mt-8">
        <a
          href={p.repo}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-1.5 rounded-[4px] text-sm font-medium text-accent transition-colors hover:text-accent-hover"
        >
          <Icon name="ph:github-logo" class="size-4" aria-hidden="true" />
          Source
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </header>

    {
      p.metrics && p.metrics.length > 0 && (
        <dl class="grid gap-x-10 gap-y-6 border-b border-rule py-10 sm:grid-cols-3">
          {p.metrics.map((m) => (
            <div>
              <dt class="sr-only">{m.label}</dt>
              <dd>
                <span
                  class="block font-mono text-[2.25rem] font-medium leading-none tracking-tight text-accent tnum"
                  data-count={m.value}
                >
                  {m.value}
                </span>
                <span class="mt-2 block max-w-[24ch] text-[15px] leading-snug text-ink-secondary">
                  {m.label}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="prose mt-12 max-w-none">
      <Content />
    </div>
  </article>
</Base>
