---
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  id="theme-toggle"
  class="grid size-9 place-items-center rounded-[4px] border border-rule text-ink-secondary transition-colors hover:border-rule-strong hover:text-ink active:translate-y-px"
  aria-label="Switch to dark theme"
>
  <Icon name="ph:sun" class="size-[18px] dark:hidden" aria-hidden="true" />
  <Icon name="ph:moon" class="hidden size-[18px] dark:block" aria-hidden="true" />
</button>

<script>
  const toggle = document.getElementById("theme-toggle");

  // The label has to describe the destination, not the current state, and it
  // is the only part of the toggle a screen reader announces.
  const syncLabel = () => {
    const isDark = document.documentElement.dataset.theme === "dark";
    toggle?.setAttribute(
      "aria-label",
      isDark ? "Switch to light theme" : "Switch to dark theme",
    );
  };

  syncLabel();

  toggle?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Preference will not persist in private mode. The toggle still works
      // for this page view, which is the part the user asked for.
    }
    syncLabel();
  });
</script>
