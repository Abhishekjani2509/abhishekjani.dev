---
import { Icon } from "astro-icon/components";
import { site } from "../lib/site";

const year = new Date().getFullYear();

const contacts = [
  { href: `mailto:${site.email}`, label: site.email, icon: "ph:envelope-simple", external: false },
  { href: site.github, label: "GitHub", icon: "ph:github-logo", external: true },
  { href: site.linkedin, label: "LinkedIn", icon: "ph:linkedin-logo", external: true },
];
---

<footer class="mt-28 border-t border-rule">
  <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
    <h2 class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      Looking for a backend or AI infrastructure role.
    </h2>
    <p class="mt-3 max-w-[54ch] text-[16.5px] leading-relaxed text-ink-secondary">
      Open to full-time software engineering roles, based in {site.location}.
      The fastest way to reach me is email.
    </p>

    <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      {
        contacts.map((c) => (
          <li>
            <a
              href={c.href}
              target={c.external ? "_blank" : undefined}
              rel={c.external ? "noreferrer" : undefined}
              class="group inline-flex items-center gap-2 rounded-[4px] text-[16px] text-ink-secondary transition-colors hover:text-accent"
            >
              <Icon
                name={c.icon}
                class="size-[18px] text-ink-muted transition-colors group-hover:text-accent"
                aria-hidden="true"
              />
              <span class="underline decoration-rule-strong decoration-1 underline-offset-4 group-hover:decoration-accent">
                {c.label}
              </span>
              {c.external && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-12 text-[14px] text-ink-muted">
      &copy; {year} {site.fullName}
    </p>
  </div>
</footer>
